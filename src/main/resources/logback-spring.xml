<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log format is intentionally aligned with the Nexpose defect-analysis pipeline:
  the FULL logger name is emitted (no abbreviation) so stack-trace class paths and
  the logger field match exactly. Do not change the pattern without updating the
  test-data log fixtures.

    2026-08-04 14:47:59,123 ERROR [http-nio-8090-exec-3] com.rapid7.nexpose.console.report.XmlReportGenerator : <message>
-->
<configuration>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger : %msg%n"/>
    <property name="LOG_FILE" value="logs/nsc.log"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/nexpose-console.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="com.rapid7.nexpose" level="DEBUG"/>
</configuration>
